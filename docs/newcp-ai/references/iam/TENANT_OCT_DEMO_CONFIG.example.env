# New CP October demo - proposed backend config (example only; not real credentials)
# Central typed config module must load/validate these; do not duplicate business defaults.
AUTH_PROVIDER=google
LOGIN_ALLOWED_DOMAINS=3ddx.com
IAM_ROLE_SOURCE=postgres
TENANT_SWITCHING_ENABLED=false
DOMAIN_TENANT_AUTO_ASSIGN_ENABLED=false
DEMO_SEED_TENANT_ID=1
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_MAX_LIFETIME_HOURS=8
AUTHZ_CHECK_ON_EVERY_REQUEST=true
DB_RLS_REQUIRED=true
# Do not add a TENANT_ID fallback for protected requests.
# Configure OIDC secrets, DB credentials, callback URLs, cookies and CSRF via secure environment/secrets manager.

# v0.9.7 security distinction:
# Tenant grants live in PostgreSQL IAM, not environment variables.
# The validated active tenant is maintained in the authenticated backend session.
# Each tenant-scoped PostgreSQL transaction receives app.tenant_id via set_config(..., true).
# Never set session.activeTenant or request tenant authorization from DEMO_SEED_TENANT_ID.
# Do not introduce ACTIVE_TENANT_ID=1 or DEFAULT_TENANT_ID=1 as API middleware fallbacks.
