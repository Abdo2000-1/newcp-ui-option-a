  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque or JWT per approved Google Auth adapter"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "FormOption": {
        "type": "object",
        "required": [
          "code",
          "label"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "CatalogService": {
        "type": "object",
        "required": [
          "uuid",
          "code",
          "name",
          "itemKind"
        ],
        "properties": {
          "uuid": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "itemKind": {
            "type": "string",
            "enum": [
              "service"
            ]
          },
          "isDigital": {
            "type": "boolean"
          },
          "workflowCode": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "FormField": {
        "type": "object",
        "required": [
          "uuid",
          "code",
          "label",
          "required",
          "options"
        ],
        "properties": {
          "uuid": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "defaultValue": {
            "type": "string",
            "nullable": true
          },
          "validation": {
            "type": "object",
            "additionalProperties": true
          },
          "conditionalRules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FormOption"
            }
          }
        }
      },
      "FormDefinition": {
        "type": "object",
        "required": [
          "service",
          "fields"
        ],
        "properties": {
          "service": {
            "$ref": "#/components/schemas/CatalogService"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FormField"
            }
          },
          "evidence": {
            "type": "string",
            "description": "Indicates whether tenant runtime mapping is verified"
          }
        }
      },
      "FormAnswer": {
        "type": "object",
        "required": [
          "fieldCode"
        ],
        "properties": {
          "fieldCode": {
            "type": "string"
          },
          "optionCode": {
            "type": "string"
          },
          "optionCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "valueText": {
            "type": "string"
          },
          "valueNumber": {
            "type": "number"
          },
          "valueBoolean": {
            "type": "boolean"
          },
          "valueDate": {
            "type": "string",
            "format": "date"
          }
        },
        "description": "Exactly one value carrier per field (except explicitly supported multi-select). Validation performed from tenant catalog + source-evidenced rules, including conditional requiredness. Prohibit unknown fields and invalid options."
      },
      "CreateServiceItem": {
        "type": "object",
        "required": [
          "sellableItemUuid",
          "answers"
        ],
        "properties": {
          "sellableItemUuid": {
            "type": "string",
            "format": "uuid"
          },
          "answers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FormAnswer"
            }
          },
          "isRedo": {
            "type": "boolean",
            "default": false
          },
          "redoOfItemUuid": {
            "type": "string",
            "format": "uuid"
          },
          "serviceNotes": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "Bill To / intended payer intentionally excluded from writable contract until item-level pre-charge mapping is resolved. Never infer from order header. This means financial Bill To editing remains BLOCKED."
      },
      "PatchServiceItem": {
        "type": "object",
        "properties": {
          "answers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FormAnswer"
            }
          },
          "isRedo": {
            "type": "boolean"
          },
          "redoOfItemUuid": {
            "type": "string",
            "format": "uuid"
          },
          "serviceNotes": {
            "type": "string"
          },
          "pendingReason": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "minProperties": 1,
        "description": "Financial fields and arbitrary status mutation omitted pending approved per-field authorization and workflow write path."
      },
      "ServiceItem": {
        "type": "object",
        "required": [
          "uuid",
          "orderUuid",
          "sellableItemUuid",
          "status",
          "answers"
        ],
        "properties": {
          "uuid": {
            "type": "string",
            "format": "uuid"
          },
          "orderUuid": {
            "type": "string",
            "format": "uuid"
          },
          "sellableItemUuid": {
            "type": "string",
            "format": "uuid"
          },
          "lineNumber": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string"
          },
          "isRedo": {
            "type": "boolean"
          },
          "isInvoiced": {
            "type": "boolean"
          },
          "currencyCode": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "unitPrice": {
            "type": "string",
            "description": "Decimal string, not floating point"
          },
          "lineTotal": {
            "type": "string"
          },
          "answers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FormAnswer"
            }
          },
          "serviceNotes": {
            "type": "string"
          }
        }
      },
      "AvailableTransition": {
        "type": "object",
        "required": [
          "transitionId",
          "fromCode",
          "toCode"
        ],
        "properties": {
          "transitionId": {
            "type": "integer",
            "format": "int64"
          },
          "fromCode": {
            "type": "string"
          },
          "toCode": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "requiresCapability": {
            "type": "string"
          },
          "guard": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "TransitionRequest": {
        "type": "object",
        "required": [
          "transitionId"
        ],
        "additionalProperties": false,
        "properties": {
          "transitionId": {
            "type": "integer",
            "format": "int64"
          },
          "comment": {
            "type": "string"
          }
        }
      },
      "TransitionResult": {
        "type": "object",
        "required": [
          "serviceItemUuid",
          "fromCode",
          "toCode",
          "changedAt"
        ],
        "properties": {
          "serviceItemUuid": {
            "type": "string",
            "format": "uuid"
          },
          "fromCode": {
            "type": "string"
          },
          "toCode": {
            "type": "string"
          },
          "changedAt": {
            "type": "string",
            "format": "date-time"
          },
          "actorUserUuid": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "HistoryEvent": {
        "type": "object",
        "properties": {
          "fromCode": {
            "type": "string"
          },
          "toCode": {
            "type": "string"
          },
          "actorUserUuid": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "comment": {
            "type": "string"
          }
        }
      }
    }
  }
}