    "/api/v1/services/{serviceItemUuid}/available-transitions": {
      "get": {
        "tags": [
          "Workflow"
        ],
        "operationId": "listServiceTransitions",
        "description": "Return currently authorized manual transitions from selected workflow instance. Do not hardcode legacy numeric statuses.",
        "parameters": [
          {
            "in": "path",
            "name": "serviceItemUuid",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AvailableTransition"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request / invalid field value",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
