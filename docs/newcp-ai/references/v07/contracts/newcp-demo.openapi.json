{
  "openapi": "3.0.3",
  "info": {
    "title": "New CP \u2014 Demo Service-Instance Contract (PROVISIONAL)",
    "version": "0.7.0-draft",
    "description": "Structural API proposal derived from verified V3 DDL and October decisions. NOT fully ratified: selected tenant catalog, workflow IDs, billing recipient write path and runtime authorization remain unresolved. No live integration tests passed."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local New CP backend; URL example, not a verified deployment"
    }
  ],
  "x-contract-status": "SCHEMA_VERIFIED / TENANT_RUNTIME_UNVERIFIED / NOT_FINAL",
  "x-source-authority": [
    "Connect Add/Create Service form fields/validators",
    "CP internal editing behavior",
    "Sanitized PostgreSQL V3 migrations V008 V011 V013 V020 V100 V130",
    "October demo decisions: multiple same-type instances"
  ],
  "x-blockers": [
    "Tenant catalog codes/UUIDs and configured fields not verified",
    "Actual state transitions and role checks not verified",
    "Pre-charge service-level billed party not mapped",
    "No backend or live DB available to run this contract"
  ],
