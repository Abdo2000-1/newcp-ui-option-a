    "/api/v1/services/{serviceItemUuid}/transitions": {
      "post": {
        "tags": [
          "Workflow"
        ],
        "operationId": "advanceServiceWorkflow",
        "description": "Authorized workflow transition via engine; status summary/history consistency must be integration-tested.",
        "parameters": [
          {
            "in": "path",
            "name": "serviceItemUuid",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransitionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
