      "post": {
        "tags": [
          "Service Instances"
        ],
        "operationId": "createOrderServiceItem",
        "description": "Create a new independent service-instance UUID even when same sellable item already exists. Server enforces field rules, authorization and tenant-scoped transaction. Idempotency-Key proposal requires explicit policy confirmation; intentional second submissions use distinct keys.",
        "parameters": [
          {
            "in": "path",
            "name": "orderUuid",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Proposed retry protection; exact retention/replay policy is a technical decision."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateServiceItem"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created service item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceItem"
                }
              }
            }
          },
          "400": {
            "description": "Bad request / invalid field value",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
