# 3DDX CP PRO MAX Frontend (Option A) Environment Configuration Template
# DO NOT store real secrets or API keys in this file.

# Application Environment (development | staging | production)
VITE_APP_ENV=development

# API Mode Configuration:
# - MOCK_BROWSER: In-browser synthetic Contract Engine (offline mock storage, default for development)
# - MOCK_HTTP: Local or staging mock HTTP server (e.g. scripts/mock-server.cjs)
# - LIVE_HTTP: Real OpenAPI 3.0 backend. Throws ApiClientError if VITE_API_BASE_URL is not set or unreachable.
VITE_API_MODE=MOCK_BROWSER

# API Base URL:
# For LIVE_HTTP: Set to the actual gateway endpoint (e.g., https://api.3ddx.example.com/v1)
# For MOCK_HTTP: Set to the mock server endpoint (e.g., http://localhost:3000/api/v1)
# Note: In LIVE_HTTP mode, requests fail immediately if this URL is empty or server returns HTTP errors.
VITE_API_BASE_URL=

# Feature Toggles
VITE_ENABLE_MOCKS=true
VITE_ENABLE_TELEMETRY=false

# Optional frontend observability providers (disabled by default)
# These names prepare the environment only; do not add real values to Git.
VITE_POSTHOG_ENABLED=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_CAPTURE_IN_DEV=false
VITE_POSTHOG_TRACK_EMAIL=false
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_TRACK_EMAIL=false

# Sentry Source-Maps & CI Upload (requires senior engineer values; disabled by default)
VITE_SENTRY_SOURCE_MAPS=false
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Authentication & OAuth 2.0 PKCE Configuration
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
VITE_AUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# Clinical CAD Engine
VITE_MAX_WEBGL_MEMORY_MB=512
